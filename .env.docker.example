# PostgreSQL stays inside the Compose network. Use URL-safe credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PROXY_MANAGER_DATABASE_URL=postgres://proxy_manager:replace-with-a-long-random-password@postgres:5432/proxy_manager?sslmode=disable

# First account created only when the database is empty.
PROXY_MANAGER_BOOTSTRAP_NAME=Administrator
PROXY_MANAGER_BOOTSTRAP_EMAIL=admin@example.com
PROXY_MANAGER_BOOTSTRAP_PASSWORD=replace-with-a-password-of-at-least-12-characters

# Use false for plain HTTP testing; true behind an HTTPS domain.
PROXY_MANAGER_COOKIE_SECURE=true

# Generate with: openssl rand -hex 32
# Copy the same value into /etc/proxy-manager/agent.env on the host.
PROXY_MANAGER_AGENT_TOKEN=replace-with-a-random-64-character-hex-token

# Read with: getent group proxy-manager-agent | cut -d: -f3
PROXY_MANAGER_AGENT_GID=999
