# --- Proxy Manager Server ---
PROXY_MANAGER_HTTP_ADDRESS=127.0.0.1:8080
PROXY_MANAGER_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/proxy_manager?sslmode=disable
# Use true when the UI is served through HTTPS.
PROXY_MANAGER_COOKIE_SECURE=false
PROXY_MANAGER_WEB_ROOT=apps/web/dist

# Bootstrap admin (runs once on empty database)
PROXY_MANAGER_BOOTSTRAP_NAME=Administrator
PROXY_MANAGER_BOOTSTRAP_EMAIL=admin@example.com
PROXY_MANAGER_BOOTSTRAP_PASSWORD=ChangeThisAdminPassword123!

# Server <-> Agent IPC
PROXY_MANAGER_AGENT_SOCKET=/run/proxy-manager/agent.sock
PROXY_MANAGER_AGENT_TOKEN=generate-a-strong-secret-token-here

# --- Proxy Manager Agent (Privileged / Root) ---
# PROXY_MANAGER_AGENT_TOKEN=same-secret-token-as-above
# PROXY_MANAGER_AGENT_SOCKET=/run/proxy-manager/agent.sock
# PROXY_MANAGER_STATE_DIR=/var/lib/proxy-manager
# PROXY_MANAGER_ACTIVE_CONFIG=/etc/nginx/proxy-manager/active.conf
# PROXY_MANAGER_NGINX_BIN=/usr/sbin/nginx
# PROXY_MANAGER_CERTBOT_BIN=/usr/bin/certbot
# PROXY_MANAGER_ACME_WEBROOT=/var/lib/proxy-manager/acme
