# Generated by Proxy Manager. Manual edits will be overwritten.
# Revision: {{ .Revision }}

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
{{ range .Sites }}
{{- if .RateLimit.Enabled }}
limit_req_zone $binary_remote_addr zone=rate_{{ .ID }}:10m rate={{ .Rate }};
{{- end }}
{{- if ne .Geo.Mode "off" }}
map $geoip2_data_country_code $geo_denied_{{ .ID }} {
    default {{ .GeoDefault }};
{{- range .GeoEntries }}
    {{ .Country }} {{ .Denied }};
{{- end }}
}
{{- end }}

upstream {{ .UpstreamName }} {
{{- if eq .LoadBalancing "least_conn" }}
    least_conn;
{{- else if eq .LoadBalancing "ip_hash" }}
    ip_hash;
{{- end }}
{{- range .Upstreams }}
    server {{ upstreamAddress .URL }} weight={{ .Weight }} max_fails={{ .MaxFails }} fail_timeout={{ .FailAfter }}s;
{{- end }}
    keepalive 32;
}

server {
    listen 80;
    server_name {{ join .Domains " " }};

    location ^~ /.well-known/acme-challenge/ {
        root {{ $.ACMEWebroot }};
        default_type text/plain;
    }
{{- if and .TLSActive .TLS.RedirectHTTP }}

    location / {
        return 308 https://$host$request_uri;
    }
{{- else }}
{{ template "proxyLocation" . }}
{{- end }}
}
{{- if .TLSActive }}

server {
    listen 443 ssl;
    server_name {{ join .Domains " " }};

    ssl_certificate {{ .Certificate }};
    ssl_certificate_key {{ .PrivateKey }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
{{ template "proxyLocation" . }}
}
{{- end }}

{{ end }}
{{ define "proxyLocation" }}
    client_max_body_size {{ .MaxBodySizeMB }}m;
{{- range .Access.DeniedCIDRs }}
    deny {{ . }};
{{- end }}
{{- range .Access.AllowedCIDRs }}
    allow {{ . }};
{{- end }}
{{- if .Access.AllowedCIDRs }}
    deny all;
{{- end }}
{{- if ne .Geo.Mode "off" }}
    if ($geo_denied_{{ .ID }}) { return 403; }
{{- end }}
{{- if ne .WAF.Mode "off" }}
    modsecurity on;
    modsecurity_rules_file {{ wafFile .WAF.Mode }};
{{- end }}
{{- if .SecurityHeaders }}
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
{{- if .TLSActive }}
    add_header Strict-Transport-Security "max-age=31536000" always;
{{- end }}
{{- end }}

    location / {
{{- if .RateLimit.Enabled }}
        limit_req zone=rate_{{ .ID }} burst={{ .RateLimit.Burst }}{{ if .RateLimit.NoDelay }} nodelay{{ end }};
        limit_req_status {{ .RateLimit.RejectStatus }};
{{- end }}
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{{- if .UpstreamTLS }}
        proxy_ssl_server_name on;
{{- end }}
        proxy_pass {{ .UpstreamURL }};
    }
{{ end }}
